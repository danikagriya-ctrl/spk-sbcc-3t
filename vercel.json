{
  "name": "spk-sbcc-3t",
  "functions": {
    "api/index.py": {
      "includeFiles": "knowledge_base/**,app/static/**,static/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.py?_path=/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index.py"
    }
  ]
}

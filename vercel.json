{
  "name": "spk-sbcc-3t",
  "functions": {
    "api/index.py": {
      "includeFiles": "knowledge_base/**,app/static/**,static/**,public/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
